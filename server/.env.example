GEMINI_API_KEY=paste_your_key_here
# Optional: MongoDB Atlas connection string (Atlas → Connect → Drivers → Node.js)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Optional: change the model if the default stops working
# GEMINI_MODEL=gemini-3.8-flash
# Optional: image model for "See it on me" try-on (copy a current image model name from AI Studio)
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
